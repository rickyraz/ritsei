DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ritsei
RITSEI_DEPLOYMENT_PROFILE=entry
RITSEI_FINANCIAL_AUTHORITY=postgresql
# PostgreSQL 19 replica read-your-writes is disabled until a reviewed standby is configured.
RITSEI_POSTGRES_RYW_ENABLED=false
# POSTGRES_REPLICA_URL=postgresql://ritsei_query:change-me@127.0.0.1:5434/ritsei
# RITSEI_POSTGRES_PLACEMENT_ID=local-cluster
# RITSEI_POSTGRES_CONSISTENCY_SECRET=replace-with-at-least-32-bytes
# RITSEI_POSTGRES_RYW_MAX_WAIT_MS=1000
# RITSEI_POSTGRES_CONSISTENCY_TTL_MS=300000
# Set TIGERBEETLE_* only when RITSEI_FINANCIAL_AUTHORITY=tigerbeetle.
# TIGERBEETLE_CLUSTER_ID=0
# TIGERBEETLE_REPLICA_ADDRESSES=127.0.0.1:3000
# TIGERBEETLE_LEDGER=1
# TIGERBEETLE_CODE=1
# TIGERBEETLE_CURRENCY=USD
WORKER_TENANT_ID=00000000-0000-4000-8000-000000000001
WORKER_ID=accounting-worker-local
